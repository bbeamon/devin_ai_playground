# Alpaca PAPER trading credentials (https://app.alpaca.markets -> Paper account -> API keys).
# Live-account keys are rejected by tradelab. Copy this file to .env and fill in.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional: market data feed for Alpaca historical data ("iex" is free; "sip" needs a subscription)
ALPACA_DATA_FEED=iex
